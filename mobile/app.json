{
  "expo": {
    "name": "JPHack",
    "slug": "jphack-mobile",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "近くの飲食店の検索と、店舗での訪問確認のために位置情報を使用します。"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "店舗での訪問写真を撮影するためにカメラを使用します。",
          "photosPermission": "訪問記録に写真を追加するために写真を使用します。",
          "microphonePermission": false
        }
      ],
      "expo-sqlite"
    ],
    "scheme": "jphack"
  }
}
